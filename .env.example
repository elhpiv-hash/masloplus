# ────────────────────────────────────────────────────────────────
# .env.example — шаблон переменных окружения проекта «Масло Плюс»
# Скопируй в .env и заполни значения. .env В РЕПОЗИТОРИЙ НЕ КОММИТИТЬ.
# Клиенту отдаются ТОЛЬКО переменные с префиксом NEXT_PUBLIC_.
# Всё чувствительное (токены) — без префикса, доступно только на сервере.
# ────────────────────────────────────────────────────────────────

# --- Приём заявок с форм (серверно) ---------------------------------
# Канал доставки заявок. Значения будут уточнены владельцем (email / telegram / both).
BOOKING_TRANSPORT=

# Email-канал (если используется): SMTP или сервис отправки
BOOKING_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Telegram-канал (если используется): токен бота и chat_id получателя — ТОЛЬКО серверно
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Анти-спам форм -------------------------------------------------
# Яндекс SmartCaptcha (по возможности). Ключ клиента публичный, серверный — секретный.
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- Галерея: источники контента (серверно) ------------------------
# Токены VK/Telegram НИКОГДА не отдаются клиенту.
VK_SERVICE_TOKEN=
TELEGRAM_CHANNEL=
VK_COMMUNITY_ID=

# --- Аналитика / карты (публичные id) ------------------------------
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# --- Базовый URL сайта (для канониклов, OG, sitemap) ---------------
NEXT_PUBLIC_SITE_URL=https://masloplus21.ru
